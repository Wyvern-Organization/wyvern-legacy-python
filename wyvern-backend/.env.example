APP_NAME=Wyvern Backend
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wyvern
REDIS_URL=redis://localhost:6379/0

WYVERN_NODE_ID=aspc
WYVERN_INDEXING=false
NODE_ROLE=main
SYNC_ENABLED=false
SYNC_PEER_API_URL=
SYNC_SHARED_SECRET=
SYNC_BRIDGE_RESYNC_INTERVAL_SECONDS=300
EDGE_MODE_ENABLED=false

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

ADMIN_ALLOWLIST=your_username#1234

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MIRROR_TARGET_URL=

LOCAL_MEDIA_DIR=media
MEDIA_URL_PREFIX=/media
GIPHY_API_KEY=
GIPHY_RATING=g
GIPHY_LIMIT=24

FREE_UPLOAD_LIMIT_BYTES=1073741824
PAID_UPLOAD_LIMIT_BYTES=1073741824

RATE_LIMIT_MESSAGE_COUNT=5
RATE_LIMIT_MESSAGE_WINDOW_SECONDS=1
RATE_LIMIT_UPLOAD_COUNT=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_COUNT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_COUNT=30
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
